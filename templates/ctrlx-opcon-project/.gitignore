# 方法论/模板仓库本体（旁级引用，不嵌套入库）
ctrlx-ai-coding/

# CODESYS/ctrlX 编译缓存、用户配置和本地备份
*.precompilecache
*.Sync.json
*.project.~u
*.~u
*.opt
*.Backup
*.Backup.*
*.compiled-library
*.projectarchive

# 加密工程容器由受控集成仓库/IDE 管理
*.project
*.project.bak_*

# 运行数据；只保留目录占位和说明
data/*
!data/README.md
!data/requests/
data/requests/*
!data/requests/.gitkeep
!data/snapshots/
data/snapshots/*
!data/snapshots/.gitkeep
!data/reports/
data/reports/*
!data/reports/.gitkeep
!data/backups/
data/backups/*
!data/backups/.gitkeep
*.log

# 原始资料和临时文件
*.zip
*.pdf
*.chm
~$*
*.tmp
Thumbs.db

# 测试缓存
__pycache__/
*.pyc
.pytest_cache/
