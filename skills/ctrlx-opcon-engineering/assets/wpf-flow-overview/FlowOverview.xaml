<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ST60 Flow Overview · WPF Demo" Width="960" Height="611"
        WindowStartupLocation="CenterScreen" Background="#F0F3F7"
        FontFamily="Microsoft YaHei" Foreground="#162B46">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Background" Value="#186AF0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#77889E"/>
    </Style>
    <Style x:Key="StageCard" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="#DFE7F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="View" Width="944" Height="572" Background="#F0F3F7" TextElement.FontFamily="Microsoft YaHei" TextElement.Foreground="#162B46">
    <Grid.RowDefinitions><RowDefinition Height="79"/><RowDefinition Height="*"/><RowDefinition Height="59"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E0E7EF" BorderThickness="0,0,0,1">
      <Grid Margin="26,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#186AF0" CornerRadius="8" Width="46" Height="42"><TextBlock Text="60" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="14,0,0,0"><TextBlock Text="ST60 · 流程总览" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="WPF / ApplicationHost 预览" Style="{StaticResource SmallLabel}" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFF4D8" CornerRadius="6" Padding="13,8"><TextBlock Text="演示数据 · PLC 未接入" Foreground="#976414" FontSize="12"/></Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,20,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,18,0">
        <Grid.RowDefinitions><RowDefinition Height="199"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource StageCard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
            <TextBlock Text="流程示意" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="READ ONLY" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
            <Canvas Grid.Row="1" Width="560" Height="110" HorizontalAlignment="Center">
              <Line X1="66" Y1="86" X2="494" Y2="86" Stroke="#D4E1F1" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Border Canvas.Left="25" Canvas.Top="8" Width="100" Height="54" Background="#EAF2FF" CornerRadius="8"><TextBlock Text="01  上料" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#256ACD" FontSize="14"/></Border>
              <Border Canvas.Left="230" Canvas.Top="8" Width="100" Height="54" Background="#EAF2FF" CornerRadius="8"><TextBlock Text="02  处理" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#256ACD" FontSize="14"/></Border>
              <Border Canvas.Left="435" Canvas.Top="8" Width="100" Height="54" Background="#EAF2FF" CornerRadius="8"><TextBlock Text="03  确认" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#256ACD" FontSize="14"/></Border>
              <Ellipse Width="11" Height="11" Fill="White" Stroke="#A7BDDB" StrokeThickness="2" Canvas.Left="69" Canvas.Top="80"/>
              <Ellipse Width="11" Height="11" Fill="White" Stroke="#A7BDDB" StrokeThickness="2" Canvas.Left="274" Canvas.Top="80"/>
              <Ellipse Width="11" Height="11" Fill="White" Stroke="#A7BDDB" StrokeThickness="2" Canvas.Left="479" Canvas.Top="80"/>
              <Border x:Name="Marker" Width="29" Height="22" CornerRadius="5" Background="#186AF0" Canvas.Left="60" Canvas.Top="75">
                <Border.RenderTransform><TranslateTransform x:Name="MarkerMotion"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#186AF0" BlurRadius="9" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                <TextBlock Text="◆" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Canvas>
            <TextBlock Grid.Row="2" Text="流转动画只展示界面能力，实际步骤由 PLC 状态驱动。" FontSize="11" Foreground="#77889E" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="2" Columns="3">
          <Border x:Name="Stage0" Style="{StaticResource StageCard}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="01" Style="{StaticResource SmallLabel}"/><TextBlock Text="上料等待" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,15"/><TextBlock x:Name="Status0" Text="演示进行中" Foreground="#186AF0" FontSize="12"/><TextBlock Text="状态绑定待接入" Style="{StaticResource SmallLabel}" Margin="0,13,0,0"/></StackPanel>
          </Border>
          <Border x:Name="Stage1" Style="{StaticResource StageCard}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="02" Style="{StaticResource SmallLabel}"/><TextBlock Text="工件处理" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,15"/><TextBlock x:Name="Status1" Text="等待演示" Foreground="#77889E" FontSize="12"/><TextBlock Text="状态绑定待接入" Style="{StaticResource SmallLabel}" Margin="0,13,0,0"/></StackPanel>
          </Border>
          <Border x:Name="Stage2" Style="{StaticResource StageCard}">
            <StackPanel><TextBlock Text="03" Style="{StaticResource SmallLabel}"/><TextBlock Text="结果确认" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,15"/><TextBlock x:Name="Status2" Text="等待演示" Foreground="#77889E" FontSize="12"/><TextBlock Text="状态绑定待接入" Style="{StaticResource SmallLabel}" Margin="0,13,0,0"/></StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
      <Border Grid.Column="1" Style="{StaticResource StageCard}">
        <StackPanel>
          <TextBlock Text="演示状态" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="当前阶段" Style="{StaticResource SmallLabel}" Margin="0,27,0,8"/>
          <TextBlock x:Name="CurrentStage" Text="上料等待" FontSize="24" FontWeight="SemiBold"/>
          <ProgressBar x:Name="StageProgress" Height="5" Margin="0,17,0,0" Maximum="100" Value="12" Foreground="#186AF0" Background="#EAF0F8" BorderThickness="0"/>
          <TextBlock Text="数据来源" Style="{StaticResource SmallLabel}" Margin="0,28,0,8"/>
          <TextBlock Text="本地动画演示" FontSize="14"/>
          <TextBlock Text="实际工程接入后读取已公开的&#10;只读状态。操作命令仍使用&#10;现有 SmartForms 页面。" FontSize="11" Foreground="#77889E" LineHeight="19" Margin="0,13,0,23"/>
          <Button x:Name="PlayButton" Content="播放演示"/>
          <Button x:Name="PauseButton" Content="暂停" Background="#EAF0F8" Foreground="#52647B" Margin="0,9,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="26,0">
      <TextBlock Text="ST60.FlowOverview.exe  →  Mod_ApplicationHost" Style="{StaticResource SmallLabel}" VerticalAlignment="Center"/>
      <TextBlock x:Name="PlaybackState" Text="演示已暂停" Foreground="#77889E" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
