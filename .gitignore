# CODESYS / ctrlX project binaries (encrypted, large, Bosch-template-derived)
*.project
*.project.~u
*.Backup
*.projectarchive
*.precompilecache
*.opt
*.Sync.json
*.Device.Application.xml
*.compiled-library

# Python
__pycache__/
*.pyc

# MCP session runtime
codesys-mcp-persistent-session*/

# OS / editor
Thumbs.db
Desktop.ini
.vscode/

# .NET Runner build output
src/runner/**/bin/
src/runner/**/obj/
tests/runner/**/bin/
tests/runner/**/obj/

# .NET Engineering Console build output
src/workbench/**/bin/
src/workbench/**/obj/
tests/workbench/**/bin/
tests/workbench/**/obj/

# Local credentials, device connection files and private key material
.env
.env.*
!.env.example
*.nxhc
*.pfx
*.p12
*.key

# Compiled/vendor runtime files are external dependencies
*.dll
*.exe
*.pdb

# Library example diagnostics generated by offline tests
skills/ctrlx-opcon-engineering/assets/library-examples/**/data/
