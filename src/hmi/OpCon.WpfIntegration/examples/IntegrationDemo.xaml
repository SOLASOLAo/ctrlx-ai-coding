<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:op="clr-namespace:OpCon.WpfIntegration;assembly=OpCon.WpfIntegration"
      Background="#EFF3F7" MinWidth="600" MinHeight="400">
  <Grid.Margin>20</Grid.Margin>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="68"/><RowDefinition Height="68"/>
  </Grid.RowDefinitions>
  <TextBlock FontSize="24" Foreground="#203246" op:NativeText.Group="IntegrationDemo" op:NativeText.Key="Title"/>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,16">
    <StackPanel>
      <TextBlock FontSize="16" op:NativeText.Group="IntegrationDemo" op:NativeText.Key="RequestCount"/>
      <TextBlock FontSize="36" Foreground="#006D77" op:NativeValue.Path="Status.RequestCount" op:NativeValue.Format="0"/>
      <TextBlock FontSize="16" op:NativeText.Group="IntegrationDemo" op:NativeText.Key="Feedback"/>
      <TextBlock FontSize="22" op:NativeValue.Path="Status.LastResult"/>
    </StackPanel>
  </Border>
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Margin="0,6,8,6" op:NativeSlot.ControlName="nativeSetpoint"/>
    <Border Grid.Column="1" Margin="8,6,0,6" op:NativeSlot.ControlName="nativePulse"/>
  </Grid>
  <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Margin="0,6,8,6" op:NativeSlot.ControlName="nativeHold"/>
    <TextBlock Grid.Column="1" Margin="8" FontSize="14" TextWrapping="Wrap"
      op:NativeText.Group="IntegrationDemo" op:NativeText.Key="NativeInputHint"/>
  </Grid>
</Grid>
