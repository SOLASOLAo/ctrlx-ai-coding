<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ops="clr-namespace:OpCon.WpfIntegration.Operations;assembly=OpCon.WpfOperations">
  <sys:String x:Key="ApplyText">确认提交</sys:String>
  <sys:String x:Key="CancelText">取消</sys:String>
  <sys:String x:Key="ObservedText">适配层当前读值</sys:String>
  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="#E7EEEF"/><Setter Property="BorderBrush" Value="#CFDADB"/>
  </Style>
  <Style TargetType="ops:WpfParameterBox">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ops:WpfParameterBox">
        <Border Background="White" BorderBrush="#D5DFE4" BorderThickness="1" CornerRadius="12" Padding="22">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Label}" Foreground="#162F3B" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource ObservedText}" Foreground="#5C7280" Margin="0,18,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <TextBlock Text="{TemplateBinding ObservedValue}" FontSize="28" FontWeight="SemiBold" Foreground="#162F3B"/>
              <TextBlock Text="{TemplateBinding Unit}" Margin="8,10,0,0" Foreground="#5C7280"/>
            </StackPanel>
            <TextBox x:Name="PART_Editor" FontSize="24" Padding="10,7" VerticalContentAlignment="Center"
                     BorderBrush="#AEC5CD" BorderThickness="1" InputMethod.IsInputMethodEnabled="False"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
              <Button x:Name="PART_Apply" Style="{StaticResource ActionButton}" Content="{DynamicResource ApplyText}"/>
              <Button x:Name="PART_Cancel" Style="{StaticResource ActionButton}" Content="{DynamicResource CancelText}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{TemplateBinding Feedback}" Foreground="#5C7280" TextWrapping="Wrap" MinHeight="40"/>
          </StackPanel>
        </Border>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ops:WpfManualKey">
    <Setter Property="MinHeight" Value="78"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ops:WpfManualKey">
      <Border x:Name="Surface" CornerRadius="10" Background="#EAF3F2" BorderBrush="#ACCEC7" BorderThickness="1" Padding="18,16">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="18"
                          TextElement.FontWeight="SemiBold" TextElement.Foreground="#145C50"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#ACE1D1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.43"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
