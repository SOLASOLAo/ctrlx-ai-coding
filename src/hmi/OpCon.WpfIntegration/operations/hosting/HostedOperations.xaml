<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="clr-namespace:OpCon.WpfIntegration.Operations;assembly=OpCon.WpfOperations"
      Background="#F1F5F7" Language="zh-CN">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="组件库 · WPF 操作视图" FontSize="26" FontWeight="SemiBold" Foreground="#162F3B"/>
      <TextBlock Text="原生操作适配器未接通 · 参数与手动输入禁用" Foreground="#9D5200" Margin="0,8,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ops:WpfParameterBox x:Name="Setpoint" Label="设定位置" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="2">
        <ops:WpfManualKey x:Name="Pulse" Content="离散操作"/>
        <TextBlock Text="{Binding Feedback, ElementName=Pulse}" Margin="0,8,0,24" TextWrapping="Wrap" Foreground="#5C7280"/>
        <ops:WpfManualKey x:Name="Hold" Content="按住操作"/>
        <TextBlock Text="{Binding Feedback, ElementName=Hold}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5C7280"/>
      </StackPanel>
    </Grid>
  </Grid>
</Grid>
