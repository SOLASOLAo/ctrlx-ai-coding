<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ops="clr-namespace:OpCon.WpfIntegration.Operations;assembly=OpCon.WpfOperations"
        Title="WPF operation input prototype — PLC not connected" Width="1000" Height="720"
        MinWidth="900" MinHeight="640" Background="#F1F5F7" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14" Language="zh-CN">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="WPF 参数框 · 手动键" FontSize="28" FontWeight="SemiBold" Foreground="#183542"/>
      <TextBlock Text="可复用输入控件最小样例  /  自有适配契约 0.1" Foreground="#5C7280" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Margin="0,18,0,18" Padding="14,10" CornerRadius="8" Background="#FFF0D4" BorderBrush="#E9CB90" BorderThickness="1">
      <TextBlock x:Name="ModeBanner" Text="尚未提供受支持的原生操作适配器：操作默认禁用，PLC 未接入。" Foreground="#78581A" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ops:WpfParameterBox x:Name="Setpoint" Label="设定位置" VerticalAlignment="Stretch"/>
      <Border Grid.Column="2" Background="White" BorderBrush="#D5DFE4" BorderThickness="1" CornerRadius="12" Padding="22">
        <StackPanel>
          <TextBlock Text="手动输入" FontSize="20" FontWeight="SemiBold" Foreground="#162F3B" Margin="0,0,0,16"/>
          <ops:WpfManualKey x:Name="Pulse" Content="离散命令 · 按下 / 释放"/>
          <ops:WpfManualKey x:Name="Hold" Content="按住型操作 · 松开结束输入" Margin="0,12,0,0"/>
          <TextBlock Text="{Binding ElementName=Hold,Path=Feedback}" Foreground="#5C7280" TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="40"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button x:Name="ToggleAvailability" Content="探针失活 / 恢复" DockPanel.Dock="Right" Padding="12,6" IsEnabled="False"/>
        <TextBlock x:Name="JournalTitle" Text="本地输入记录：0  ·  PLC 接收、扫描周期及执行结果：未测量" Foreground="#4C6572" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox Grid.Row="1" x:Name="Journal" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderBrush="#D5DFE4"/>
    </Grid>
  </Grid>
</Window>
