<Window x:Class="CtrlX.OpCon.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ctrlX OpCon Engineering Console"
        Width="1120" Height="720" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ctrlX OpCon Engineering" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="工程流程控制台" Foreground="#BFD8E7" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="PROJECT" Foreground="#91B4C8" FontSize="10" HorizontalAlignment="Right" />
                    <TextBlock x:Name="EngineeringRootText" Foreground="White" FontSize="12" MaxWidth="560"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#E6F5F0" BorderBrush="#B7DCCE" BorderThickness="0,0,0,1" Padding="18,6">
            <TextBlock Foreground="{StaticResource SafeBrush}" FontSize="12" FontWeight="SemiBold"
                       Text="OFFLINE ONLY / 仅离线工程操作  ·  在线 PLC 操作已禁用" />
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="12,8" Background="Transparent" BorderBrush="{StaticResource LineBrush}">
            <TabItem Header="WORKBENCH / 工作台">
                <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StateIndicator" Width="14" Height="14" Fill="#8795A1"
                                         VerticalAlignment="Top" Margin="0,7,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CURRENT / 当前" Style="{StaticResource LabelText}" />
                                    <TextBlock x:Name="StateCaptionText" Text="Refreshing…" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    <TextBlock x:Name="StateCodeText" Text="UNKNOWN" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="HostStateText" Text="Host: UNKNOWN" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,18,0">
                                    <TextBlock Text="NEXT / 下一步" Style="{StaticResource LabelText}" />
                                    <TextBlock x:Name="NextActionText" Text="Refresh status." TextWrapping="Wrap"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <Button x:Name="RunNextButton" Content="Run next / 继续" Style="{StaticResource PrimaryButton}"
                                            Click="RunNext_Click" MinWidth="150" />
                                    <Button x:Name="RefreshButton" Content="Refresh / 刷新" Click="Refresh_Click" MinWidth="150" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PROGRESS / 进度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <StackPanel x:Name="PhasePanel" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="WORKFLOW / 流程" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel x:Name="WorkflowPanel">
                                        <TextBlock Text="1  IOE：Plan → checkpoint → Apply → readback" FontWeight="SemiBold" Margin="0,6" />
                                        <TextBlock Text="2  CpStudio：Import ASC → Write designators → Export #1" Margin="0,6" />
                                        <TextBlock Text="3  Runner + PLE：Audit → Link I/O → Build" Margin="0,6" />
                                        <TextBlock Text="4  CpStudio：按需 Export #2 → final Build" Margin="0,6" />
                                    </StackPanel>
                                    <Border Background="#FFF7E8" BorderBrush="#F0D4A4" BorderThickness="1" CornerRadius="4"
                                            Padding="10,7" Margin="0,10,0,0">
                                        <TextBlock Text="CpStudio / PLE 的官方 IDE 操作会暂停并明确提示，不会后台偷偷执行。"
                                                   Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOOLS / 工具" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,14,7" />
                                <WrapPanel Grid.Column="1">
                                    <Button x:Name="HostStartButton" Content="Start Host" Click="HostStart_Click" />
                                    <Button x:Name="HostStopButton" Content="Stop Host" Click="HostStop_Click" />
                                    <Button Content="Open CpStudio" Click="OpenCpStudio_Click" />
                                    <Button Content="Project folder" Click="OpenRoot_Click" />
                                </WrapPanel>
                                <Button Grid.Column="2" Content="Latest evidence" Click="OpenLatestManifest_Click" />
                            </Grid>
                        </Border>
                </Grid>
            </TabItem>

            <TabItem Header="PLAN / P2">
                <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PROJECT PACK / 工程计划" Style="{StaticResource LabelText}" />
                                    <TextBlock x:Name="ProjectPackStateText" Text="Not checked" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock x:Name="PlanPathText" Text="generated/engineering-plan.json" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,3,16,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="CheckProjectPackButton" Content="Check" Style="{StaticResource PrimaryButton}" Click="CheckProjectPack_Click" />
                                    <Button Content="Open plan" Click="OpenPlan_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="P2 · IOE HARDWARE APPLY" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="硬件组态的受控变更闭环" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Apply（尚未开放）" IsEnabled="False" MinWidth="150" />
                                </Grid>
                                <UniformGrid Columns="4">
                                    <Border Background="#F5F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                                        <StackPanel><TextBlock Text="1  PLAN" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" /><TextBlock Text="只读计算改动" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="#F5F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                                        <StackPanel><TextBlock Text="2  CHECKPOINT" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" /><TextBlock Text="保存可恢复起点" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="#F5F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                                        <StackPanel><TextBlock Text="3  APPLY" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" /><TextBlock Text="IOE 官方接口应用" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="#F5F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12">
                                        <StackPanel><TextBlock Text="4  READBACK" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" /><TextBlock Text="重开并逐项核对" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Text="只有四步全部通过，Apply 才会从灰色变为可用。当前版本仍保持禁用。"
                                           Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="BOUNDARY / 边界" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="CpStudio 管模型、接口与 HMI；IOE 管硬件拓扑；Runner + AI 管离线检查、证据与已批准的 PLC 实现。"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="电气 I/O 交换统一使用完整 ASC。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="EVIDENCE / 证据">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LATEST EVIDENCE / 最新证据" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="ManifestPathText" Text="No manifest found" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,5,12,0" />
                                <TextBlock x:Name="GuardrailText" Text="Online operations: false" Foreground="{StaticResource SafeBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Open" Click="OpenLatestManifest_Click" />
                                <Button Content="Copy output" Click="CopyOutput_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="OUTPUT / 输出" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Grid.Row="1" x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#101820" Foreground="#D7E5EC"
                                     BorderThickness="0" Padding="10" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#DCE6EC" Padding="14,4">
            <Grid>
                <TextBlock x:Name="FooterText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="P2 Apply disabled  ·  Online disabled" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
