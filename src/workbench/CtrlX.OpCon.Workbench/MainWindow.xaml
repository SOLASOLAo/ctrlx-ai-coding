<Window x:Class="CtrlX.OpCon.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ctrlX OpCon Engineering Console"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ctrlX OpCon Engineering Console" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="CpStudio + ctrlX guided offline workflow" Foreground="#BFD8E7" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="ENGINEERING ROOT" Foreground="#91B4C8" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock x:Name="EngineeringRootText" Foreground="White" FontSize="12" MaxWidth="620" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#E6F5F0" BorderBrush="#B7DCCE" BorderThickness="0,0,0,1" Padding="22,9">
            <TextBlock Foreground="{StaticResource SafeBrush}" FontWeight="SemiBold"
                       Text="OFFLINE ENGINEERING ONLY  ·  No PLC connect, download, runtime control, FORCE, or arbitrary scripts" />
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="16,12,16,10" Background="Transparent" BorderBrush="{StaticResource LineBrush}">
            <TabItem Header="WORKBENCH / 工作台">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT STATE / 当前状态" Style="{StaticResource LabelText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse x:Name="StateIndicator" Width="14" Height="14" Fill="#8795A1" Margin="0,5,10,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock x:Name="StateCaptionText" Text="Refreshing…" FontSize="21" FontWeight="SemiBold" />
                                            <TextBlock x:Name="StateCodeText" Text="UNKNOWN" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Margin="0,14,0,12" />
                                    <TextBlock Text="NEXT ACTION / 下一步" Style="{StaticResource LabelText}" />
                                    <TextBlock x:Name="NextActionText" Text="Refresh status." TextWrapping="Wrap" FontSize="16" Margin="0,6,0,0" />
                                    <TextBlock x:Name="HostStateText" Text="Host: UNKNOWN" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SAFE ACTIONS / 受控操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <WrapPanel>
                                        <Button x:Name="RefreshButton" Content="Refresh / 刷新" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" />
                                        <Button x:Name="RunNextButton" Content="Run next / 继续" Style="{StaticResource PrimaryButton}" Click="RunNext_Click" />
                                        <Button x:Name="HostStartButton" Content="Start Host" Click="HostStart_Click" />
                                        <Button x:Name="HostStopButton" Content="Stop Host" Click="HostStop_Click" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="Open CpStudio" Click="OpenCpStudio_Click" />
                                        <Button Content="Open project folder" Click="OpenRoot_Click" />
                                        <Button Content="Open latest evidence" Click="OpenLatestManifest_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="Each button calls a fixed, allowlisted entry point. There is no command box."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ENGINEERING PROGRESS / 工程自动化进度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <StackPanel x:Name="PhasePanel" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GUIDED WORKFLOW / 标准闭环" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="The console pauses at every official IDE boundary and resumes from evidence."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14" />
                                    <StackPanel x:Name="WorkflowPanel">
                                        <TextBlock Text="1   IOE: Plan → checkpoint → Apply → reopen/readback" FontWeight="SemiBold" Margin="0,7" />
                                        <TextBlock Text="2   CpStudio: Read fieldbus config → Import complete ASC → Save" Margin="0,7" />
                                        <TextBlock Text="3   CpStudio: Write designators to PLC IDE → Export #1" Margin="0,7" />
                                        <TextBlock Text="4   Runner: Stage 1 audit → immutable action/evidence" Margin="0,7" />
                                        <TextBlock Text="5   AI review: inspect structured evidence; no embedded AI or automatic online action" Margin="0,7" />
                                        <TextBlock Text="6   PLE: Link I/O with variables → Build/readback" Margin="0,7" />
                                        <TextBlock Text="7   CpStudio: conditional Export #2 → final Build/readback" Margin="0,7" />
                                    </StackPanel>
                                    <Separator Margin="0,14,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="P2 IOE APPLY" FontWeight="SemiBold" />
                                            <TextBlock Text="Disabled until Plan/checkpoint/Apply/readback backend contract passes regression."
                                                       Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,3,16,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Apply (not available)" IsEnabled="False" MinWidth="160" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="HUMAN CHECKPOINTS / 人工操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="• CpStudio remains the source of Station/Unit/HMI/interfaces." Margin="0,4" />
                                    <TextBlock Text="• CpStudio Save, Import ASC, Write designators and Export remain visible user actions." Margin="0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="• PLE Link I/O remains one manual click until an official stable interface is proven." Margin="0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="• Field download and runtime actions are outside this console." Margin="0,4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PLAN / REVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PROJECT PACK / 工程计划" Style="{StaticResource LabelText}" />
                                    <TextBlock x:Name="ProjectPackStateText" Text="Not checked" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="PlanPathText" Text="generated/engineering-plan.json" Foreground="{StaticResource MutedBrush}" Margin="0,5,16,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="CheckProjectPackButton" Content="Check Project Pack" Style="{StaticResource PrimaryButton}" Click="CheckProjectPack_Click" />
                                    <Button Content="Open plan" Click="OpenPlan_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OWNERSHIP / 所有权边界" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F5F8FA" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="CpStudio / User" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                            <TextBlock Text="Model, generated interfaces, HMI, events, StationData/TypeData, official Export steps" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F5F8FA" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Runner + AI" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" />
                                            <TextBlock Text="Offline audits, approved PLC implementation, Build evidence, deterministic plans and reports" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="INPUT POLICY / 输入策略" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Electrical I/O exchange uses one complete ASC. ASC owns designators/descriptions; IOE owns module order and hardware types."
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="P2 Apply is intentionally unavailable in this version." Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EVIDENCE / 证据">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LATEST RUN MANIFEST / 最新运行证据" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="ManifestPathText" Text="No manifest found" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,12,0" />
                                <TextBlock x:Name="GuardrailText" Text="Online operations: false" Foreground="{StaticResource SafeBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Open manifest" Click="OpenLatestManifest_Click" />
                                <Button Content="Copy output" Click="CopyOutput_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="COMMAND OUTPUT / 命令输出" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBox Grid.Row="1" x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#101820" Foreground="#D7E5EC"
                                     BorderThickness="0" Padding="12" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#DCE6EC" Padding="16,5">
            <Grid>
                <TextBlock x:Name="FooterText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="P2 Apply disabled  ·  Online operations disabled" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
